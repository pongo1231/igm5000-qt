# Grant the logged-in user access to the ISY IGM 5000 vendor control interface.
# The mouse exposes two HID interfaces; only the second one (bInterfaceNumber 01)
# carries the vendor feature reports (ID 5 = command channel, ID 8 = data channel).
#
# Install as /etc/udev/rules.d/99-isymouse.rules then:
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hidraw

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="002e", ATTRS{bInterfaceNumber}=="01", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="002f", ATTRS{bInterfaceNumber}=="01", TAG+="uaccess"
